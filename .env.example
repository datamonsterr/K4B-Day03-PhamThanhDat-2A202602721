# ==========================================
# MULTI-PROVIDER LLM ADAPTER CONFIGURATION
# ==========================================

# Lựa chọn LLM Provider: "gemini", "openai", "anthropic", "openrouter", hoặc "mock" (offline)
LLM_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# OpenAI / 9router API Configuration
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=http://localhost:20128/v1
# LLM_MODEL=gh/gpt-4o-mini

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-3-5-haiku-20241022

# MCP & Backend Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000
STREAMLIT_PORT=8501

# Meta Threads API Configuration
THREAD_APP_ID=your_threads_app_id_here
THREAD_APP_SECRET=your_threads_app_secret_here
# THREAD_ACCESS_TOKEN=your_threads_access_token_here
# THREAD_USER_ID=me
